# ARGO MOSAIC — deployed at /Argo-Mosaic/
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /Argo-Mosaic/

  # Never expose deployment configuration or database exports.
  <FilesMatch "^(config\.local\.php|database.*\.(sql|json)|\.env)$">
    Require all denied
  </FilesMatch>

  # API routes
  RewriteRule ^api/products/?$ api/products.php [L,QSA]
  RewriteRule ^api/products/([^/]+)/?$ api/products.php?id=$1 [L,QSA]
  RewriteRule ^api/orders/?$ api/orders.php [L,QSA]
  RewriteRule ^api/orders/([^/]+)/?$ api/orders.php?id=$1 [L,QSA]
  RewriteRule ^api/quotes/?$ api/quotes.php [L,QSA]
  RewriteRule ^api/quotes/([^/]+)/?$ api/quotes.php?id=$1 [L,QSA]
  RewriteRule ^api/samples/?$ api/samples.php [L,QSA]
  RewriteRule ^api/settings/?$ api/settings.php [L,QSA]
  RewriteRule ^api/sales-reps/?$ api/sales_reps.php [L,QSA]
  RewriteRule ^api/sales-reps/([^/]+)/?$ api/sales_reps.php?id=$1 [L,QSA]
  RewriteRule ^api/upload/?$ api/upload.php [L,QSA]
  RewriteRule ^api/paypal/create-order/?$ api/paypal.php?action=create [L,QSA]
  RewriteRule ^api/paypal/capture-order/?$ api/paypal.php?action=capture [L,QSA]
  RewriteRule ^api/admin/login/?$ api/auth.php [L,QSA]

  # Public storefront URL: serve the React app without nesting the API.
  RewriteRule ^argomosaic/?$ index.html [L]

  # Existing files and folders pass through unchanged.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React SPA routes.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/json
</IfModule>
